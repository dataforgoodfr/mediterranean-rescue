{
  "name": "rescue-atlas-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest run",
    "i18n:missing": "node tools/i18n-missing.ts",
    "api:types": "openapi-typesafe ../backend/openapi.json -o src/api/schema.ts",
    "api:check": "openapi-typesafe ../backend/openapi.json -o src/api/schema.ts --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@vis.gl/react-maplibre": "^8.1.3",
    "maplibre-gl": "^6.19.0",
    "openapi-typesafe": "^1.0.0-rc.16",
    "openapi-typesafe-fetch": "^1.0.0-rc.16",
    "openapi-typesafe-react-query": "^1.0.0-rc.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.8",
    "oxfmt": "0.79.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
