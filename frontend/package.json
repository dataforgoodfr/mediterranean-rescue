{
  "name": "rescue-atlas-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "api:types": "pnpm --dir outils/types-api install --frozen-lockfile && pnpm --dir outils/types-api generer",
    "api:verifier": "pnpm --dir outils/types-api install --frozen-lockfile && pnpm --dir outils/types-api verifier"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
