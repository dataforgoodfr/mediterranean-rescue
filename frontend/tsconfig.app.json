{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Résolution des modules par Vite */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // `@/` désigne src/ : `import { getHealth } from '@/api'`, d'où qu'on soit. Le même alias
    // est dans vite.config.ts. https://www.typescriptlang.org/tsconfig/#paths
    "paths": { "@/*": ["./src/*"] },

    /* Contrôles */
    // Le mode strict, plus la case vide d'un tableau ou d'un objet : `liste[0]` peut être
    // undefined. https://www.typescriptlang.org/tsconfig/#strict
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
