  "paths": {
    "/api/backoffice/operations": {
      "get": {
        "description": "Liste les opérations, de la plus ancienne à la plus récente.",
        "operationId": "list_operations_api_backoffice_operations_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/OperationState"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OperationBackoffice"
                  },
                  "title": "Response List Operations Api Backoffice Operations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Operations"
      }
    },
    "/api/health": {
      "get": {
        "description": "Answers while the server runs, without touching the database.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/operations": {
      "get": {
        "description": "Liste les opérations publiées, de la plus ancienne à la plus récente.",
        "operationId": "list_operations_api_operations_get",
