  "paths": {
    "/api/health": {
      "get": {
        "description": "Answers while the server runs, without touching the database.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/operations": {
      "get": {
        "description": "Every operation, oldest first. Positions are in decimal degrees (WGS 84), north and east\npositive.",
        "operationId": "list_operations_api_operations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OperationPublic"
                  },
                  "title": "Response List Operations Api Operations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Operations"
      }
    }
