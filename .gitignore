# Ce que Git ne suit pas. Le frontend a aussi son propre frontend/.gitignore.
# Volontairement court : un motif large comme `lib/` cacherait un vrai dossier de code.

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets et réglages locaux : jamais dans Git
.env
.env.*
!.env.example

# Données locales, jamais dans Git (voir data/README.md)
data/*
!data/README.md

# Éditeurs et système
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
